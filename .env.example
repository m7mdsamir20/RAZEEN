# =========================================================
# رزيم العقارية — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git.
# =========================================================

# ---------- قاعدة البيانات ----------
# التطوير (SQLite):
DATABASE_URL="file:./prisma/dev.db"
# الإنتاج (MariaDB/MySQL) — استبدل القيمة أعلاه بهذه:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# ---------- الجلسات ----------
# 32 حرفاً على الأقل. ولّد واحداً جديداً للإنتاج:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# ---------- عنوان الموقع ----------
# يُستخدم في روابط SEO وملف sitemap
NEXT_PUBLIC_APP_URL="https://example.com"

# ---------- خرائط جوجل ----------
# مفتاحان منفصلان عمداً:
# 1) مفتاح المتصفح — مقيّد بنطاق موقعك، ومفعّل عليه Maps JavaScript API فقط
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# 2) مفتاح الخادم — بدون NEXT_PUBLIC، مقيّد بعنوان IP الخادم،
#    ومفعّل عليه Geocoding API + Places API
GOOGLE_MAPS_SERVER_KEY=""

# ---------- الرسائل النصية (OTP) ----------
# console = يطبع الرمز في السجل بدل إرساله (للتطوير فقط)
# authentica | unifonic | taqnyat | twilio = إرسال حقيقي
SMS_PROVIDER="console"

# Authentica
AUTHENTICA_API_KEY=""
AUTHENTICA_TEMPLATE_ID=""

# ---------- نفاذ ----------
# false = زر طلب الخدمة متاح للجميع بدون توثيق نفاذ
REQUIRE_NAFATH="false"
NEXT_PUBLIC_REQUIRE_NAFATH="false"
